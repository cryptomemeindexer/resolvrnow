{
 "browser": {
  "mode": "launch",
  "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "headless": true
 },
 "start_url": {
  "url": "http://localhost:18080/login"
 },
 "environment": {
  "viewport": {
   "width": 1440,
   "height": 900,
   "device_scale_factor": 1
  },
  "color_scheme": "light"
 },
 "secrets": [
  {
   "secret_id": "demo_user",
   "environment_variable": "RN_DEMO_USER"
  },
  {
   "secret_id": "demo_pass",
   "environment_variable": "RN_DEMO_PASS"
  }
 ],
 "actions": [
  {
   "step_id": "wait_login",
   "action": "wait_for",
   "locator": {
    "kind": "css",
    "selector": "#u"
   },
   "state": "visible",
   "timeout_ms": 15000
  },
  {
   "step_id": "fill_user",
   "action": "fill",
   "locator": {
    "kind": "css",
    "selector": "#u"
   },
   "value": {
    "source": "secret",
    "secret_id": "demo_user"
   }
  },
  {
   "step_id": "fill_pass",
   "action": "fill",
   "locator": {
    "kind": "css",
    "selector": "#p"
   },
   "value": {
    "source": "secret",
    "secret_id": "demo_pass"
   }
  },
  {
   "step_id": "submit",
   "action": "click",
   "locator": {
    "kind": "role",
    "role": "button",
    "name": "Sign in"
   },
   "timeout_ms": 10000
  },
  {
   "step_id": "home",
   "action": "wait_for",
   "locator": {
    "kind": "css",
    "selector": "nav[aria-label=Applications]"
   },
   "state": "visible",
   "timeout_ms": 15000
  },
  {
   "step_id": "open_record",
   "action": "goto",
   "destination": {
    "url": "http://localhost:18080/workspace/record/task/<sys_id>"
   },
   "wait_until": "load"
  },
  {
   "step_id": "record_ready",
   "action": "wait_for",
   "locator": {
    "kind": "css",
    "selector": "h3"
   },
   "state": "visible",
   "timeout_ms": 15000
  },
  {
   "step_id": "settle",
   "action": "wait_for_timeout",
   "duration_ms": 1500
  }
 ],
 "capture": {
  "at_end": [
   "screenshot",
   "accessibility",
   "url"
  ],
  "events": [
   "page-errors",
   "console"
  ]
 }
}