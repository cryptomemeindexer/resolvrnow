# Dependencies do not run install scripts. better-sqlite3 and fsevents ship
# prebuilt binaries, but npm ci would still try to compile them with node-gyp,
# which fails on machines without Python and a C++ toolchain (including the
# slim Docker image). esbuild works without its optional postinstall step.
# If a new dependency really needs its script, run `npm rebuild <package>`.
ignore-scripts=true
